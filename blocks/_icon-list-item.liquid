{%- assign icon = block.settings.icon -%}
<li class="hdt-il__item" {{ block.shopify_attributes }}>
  <span class="hdt-il__icon" aria-hidden="true">
    {%- if block.settings.image != blank -%}
      {{ block.settings.image | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48, 96', alt: '' }}
    {%- else -%}
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        focusable="false">
        {%- case icon -%}
          {%- when 'gift' -%}
            <rect
              x="3"
              y="8"
              width="18"
              height="4"
              rx="1" /><path d="M12 8v13" /><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7" /><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5" />
          {%- when 'star' -%}
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
          {%- when 'shield-check' -%}
            <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /><path d="m9 12 2 2 4-4" />
          {%- when 'package' -%}
            <path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z" /><path d="M12 22V12" /><path d="m3.3 7 8.7 5 8.7-5" /><path d="m7.5 4.27 9 5.15" />
          {%- when 'coffee' -%}
            <path d="M10 2v2" /><path d="M14 2v2" /><path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1" /><path d="M6 2v2" />
          {%- when 'award' -%}
            <path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526" /><circle
              cx="12"
              cy="8"
              r="6" />
          {%- when 'heart' -%}
            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
          {%- when 'truck' -%}
            <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2" /><path d="M15 18H9" /><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14" /><circle
              cx="17"
              cy="18"
              r="2" /><circle
              cx="7"
              cy="18"
              r="2" />
          {%- when 'users' -%}
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle
              cx="9"
              cy="7"
              r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />
          {%- when 'clock' -%}
            <circle
              cx="12"
              cy="12"
              r="10" /><polyline points="12 6 12 12 16 14" />
          {%- when 'globe' -%}
            <circle
              cx="12"
              cy="12"
              r="10" /><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" /><path d="M2 12h20" />
          {%- else -%}
            <polyline points="20 6 9 17 4 12" />
        {%- endcase -%}
      </svg>
    {%- endif -%}
  </span>
  <span class="hdt-il__text">{{ block.settings.text | escape }}</span>
</li>

{% schema %}
  {
    "name": "Icon list item",
    "settings": [
      {
        "type": "text",
        "id": "text",
        "label": "Text",
        "default": "نقطة جديدة"
      }, {
        "type": "select",
        "id": "icon",
        "label": "Icon",
        "options": [
          {
            "value": "check",
            "label": "Check"
          },
          {
            "value": "gift",
            "label": "Gift"
          },
          {
            "value": "star",
            "label": "Star"
          },
          {
            "value": "shield-check",
            "label": "Shield check"
          }, {
            "value": "package",
            "label": "Box / package"
          }, {
            "value": "coffee",
            "label": "Coffee"
          }, {
            "value": "award",
            "label": "Medal / award"
          }, {
            "value": "heart",
            "label": "Heart"
          }, {
            "value": "truck",
            "label": "Truck"
          }, {
            "value": "users",
            "label": "People"
          }, {
            "value": "clock",
            "label": "Clock"
          }, {
            "value": "globe",
            "label": "Globe"
          }
        ],
        "default": "check"
      }, {
        "type": "image_picker",
        "id": "image",
        "label": "Custom icon (optional)",
        "info": "Upload your own icon. It replaces the icon above."
      }
    ]
  }
{% endschema %}